{
  "name": "@saypulse/core",
  "version": "0.1.0",
  "private": false,
  "description": "SayPulse — Framework-agnostic core: AudioRecorder, ContextHarvester, StorageBridge, ApiClient, PiiRedactor",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}

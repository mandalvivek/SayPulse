# ──────────────────────────────────────────────────────────
# SayPulse Dedicated Subdomain & Production CDN .htaccess
# ──────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect any direct folder access on main domain to dedicated subdomain
    RewriteCond %{HTTP_HOST} ^(www\.)?nextgenmultiverse\.com$ [NC]
    RewriteRule ^(.*)$ https://saypulse.nextgenmultiverse.com/$1 [R=301,L]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map /admin routes to admin.html
    RewriteRule ^admin(/.*)?$ admin.html [L,QSA]

    # Map /demo routes to demo.html
    RewriteRule ^demo(/.*)?$ demo.html [L,QSA]

    # Fallback all other routes to index.html
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, X-SayPulse-Key, Authorization"
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/pdf .pdf
    AddType image/x-icon .ico
    AddType image/svg+xml .svg
</IfModule>


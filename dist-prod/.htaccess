# ──────────────────────────────────────────────────────────
# SayPulse Dedicated Subdomain & Production CDN .htaccess
# ──────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect any direct folder access on main domain to dedicated subdomain
    RewriteCond %{HTTP_HOST} ^(www\.)?nextgenmultiverse\.com$ [NC]
    RewriteRule ^(.*)$ https://saypulse.nextgenmultiverse.com/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, X-SayPulse-Key"
</IfModule>

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/pdf .pdf
</IfModule>
